# Loaded by `vite --mode selfhosted` (npm run dev:selfhosted / build:selfhosted).
# Self-hosted build pointed at the ClearAlan API: no other external contact.
# Clear VITE_TEMPLATE_API_URL (or override with an empty value in
# .env.selfhosted.local) for a fully-offline build with the cloud UI hidden.
VITE_SELF_HOSTED=true
VITE_TEMPLATE_API_URL=https://api.cadesign.clearalan.ca
VITE_DEVICES_URL=https://devices.cadesign.clearalan.ca
VITE_DOCS_URL=https://docs.cadesign.clearalan.ca
